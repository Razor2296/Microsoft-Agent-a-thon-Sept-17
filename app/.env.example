# Copy to app/.env and fill secrets. Never commit real keys.
# Optional multi-env files (selected by IGNITE_ENV):
#   development/dev/local -> .env
#   staging/stage         -> .env.staging
#   production/prod       -> .env.prod
# IGNITE_ENV=development

# local | remote | server
IGNITE_RUNTIME_MODE=local

# Conversation language fallback when UI/history/detection are empty (NOT a forced chat language).
# Sticky policy: keep the first-turn language so slang does not flip the thread.
# Switch when the user explicitly asks OR when the latest utterance is clearly in another language.
# Override maps (optional JSON): IGNITE_ISO_LANG_MAP_JSON, IGNITE_LANG_NAME_ALIASES_JSON,
# IGNITE_SCRIPT_LANG_HINTS_JSON, IGNITE_LANG_SWITCH_PATTERNS_JSON, IGNITE_LANG_FUNCTION_WORDS_JSON
IGNITE_DEFAULT_CONVERSATION_LANGUAGE=es-MX
# Minimum characters before a typed/STT turn can shift language without unique script hints (¿ ¡ ñ).
IGNITE_LANG_UTTERANCE_SWITCH_MIN_CHARS=24
IGNITE_LANG_SCRIPT_HINT_MIN_CHARS=8
IGNITE_LANG_FUNCTION_WORD_MARGIN=2
IGNITE_LANG_FUNCTION_WORD_MIN_SCORE=3

# Lightweight observability (structured logs + GET /metrics counters)
# IGNITE_OTEL_ENABLED=true

# --- Microsoft Foundry orchestration (Agent-a-thon GOD path) ---
# Chat turn → Traces ON → ensure agents+workflow (Gemini) → invoke workflow.
FOUNDRY_ORCHESTRATION_ENABLED=true
# Every Chat turn in scope (STD-014). Set false for legacy extract-only filter.
FOUNDRY_ORCHESTRATION_ALWAYS=true
# Mic / generate / plain chat: async Traces (video-safe). Extract/DOC stays sync for footer.
FOUNDRY_TRACE_ASYNC=true
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
# From Foundry project juliancuray-7914 Overview:
# PROJECT_CONNECTION_STRING=https://....services.ai.azure.com/api/projects/juliancuray-7914
# APPLICATIONINSIGHTS_CONNECTION_STRING=
# Deploy Gemini in Foundry → Models, then set the deployment name:
MODEL_DEPLOYMENT_NAME=gemini-2.5-flash
FOUNDRY_REFRESH_AGENTS=true
# IGNITE_WORKFLOW_AGENT=ignite-document-workflow

# Remote thin-client settings (when IGNITE_RUNTIME_MODE=remote)
# PAYG example (kvignitechatsiu secret IGNITE-API-KEY):
# IGNITE_API_BASE_URL=https://ignitechat-api.orangefield-53e31d49.eastus2.azurecontainerapps.io
IGNITE_API_BASE_URL=https://ignitechat-api.orangefield-53e31d49.eastus2.azurecontainerapps.io
IGNITE_API_KEY=replace-me
IGNITE_API_TIMEOUT=300
IGNITE_DOCUMENT_API_TIMEOUT=900
# UI poll budget for send_message_async (ms). Documents use the longer document value.
IGNITE_GENERATION_POLL_TIMEOUT_MS=1200000
IGNITE_DOCUMENT_POLL_TIMEOUT_MS=1800000
IGNITE_GEMINI_HTTP_TIMEOUT_MS=900000
IGNITE_LLM_HTTP_TIMEOUT=900
# Long PDF / book summaries: native Gemini/Anthropic PDF when under these caps.
IGNITE_PDF_MAX_FULL_TEXT_CHARS=400000
IGNITE_PDF_MAX_RETRIEVED_PAGES=12
IGNITE_PDF_SUMMARY_SAMPLE_PAGES=80
IGNITE_PDF_IMAGE_PAGE_SCAN_LIMIT=8
# Grok multimodal rejects images below this total pixel count (skip tiny PDF/DOCX logos).
IGNITE_VISION_MIN_IMAGE_PIXELS=512
# Anthropic Messages API decoded image cap (compress above this).
IGNITE_ANTHROPIC_MAX_IMAGE_BYTES=10485760
# Perplexity Sonar: max chars of user/file prompt (PDF+describe can blow context).
IGNITE_PERPLEXITY_MAX_PROMPT_CHARS=100000
# Gemini describe_image (Perplexity/DeepSeek path): compress above this size.
IGNITE_DESCRIBE_IMAGE_MAX_BYTES=4194304
IGNITE_PDF_NATIVE_MAX_BYTES=20971520
IGNITE_PDF_NATIVE_MAX_PAGES=100
GROUP_MAX_PARALLEL=6
# Optional override for welcome text / UI name in remote mode
# IGNITE_USER_NAME=Julian

# Server / ACA
IGNITE_API_HOST=0.0.0.0
IGNITE_API_PORT=8000
IGNITE_DATA_DIR=/data
IGNITE_CORS_ORIGINS=*

# Provider keys (server or local mode)
GEMINI_API_KEY=
GEMINI_MODEL_VERSION=gemini-3.1-flash-lite
GEMINI_AVAILABLE_MODELS=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.5-flash,gemini-3.1-pro-preview

# OpenAI chat — use Azure Foundry when OPENAI_BASE_URL / AZURE_OPENAI_ENDPOINT is set
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://foundryignitechatsiu-87996.openai.azure.com/openai/v1
OPENAI_BASE_URL=https://foundryignitechatsiu-87996.openai.azure.com/openai/v1
OPENAI_MODEL_VERSION=gpt-4.1-mini
OPENAI_AVAILABLE_MODELS=gpt-4.1-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_VERSION=claude-fable-5
ANTHROPIC_AVAILABLE_MODELS=claude-fable-5,claude-opus-5,claude-opus-4-8,claude-opus-4-6,claude-haiku-4-5-20251001
PERPLEXITY_API_KEY=
PERPLEXITY_MODEL_VERSION=sonar
PERPLEXITY_AVAILABLE_MODELS=sonar,sonar-pro,sonar-reasoning
GROK_API_KEY=
GROK_MODEL_VERSION=grok-4.3
GROK_AVAILABLE_MODELS=grok-4.3,grok-4.5,grok-4.20-0309-reasoning,grok-4.20-0309-non-reasoning
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL_VERSION=deepseek-v4-pro
DEEPSEEK_AVAILABLE_MODELS=deepseek-v4-pro,deepseek-v4-flash
CARTESIA_API_KEY=
WHISPER_BEAM_SIZE=1

# Ignite API S2S Extraction Integration
IGNITE_EXTRACTION_ENABLED=true
IGNITE_EXTRACTION_API_URL=https://ignite-api.orangefield-53e31d49.eastus2.azurecontainerapps.io
IGNITE_EXTRACTION_API_KEY=replace-me
IGNITE_EXTRACTION_POLL_INTERVAL=3
# Sync POST read + async poll budget (Ignite API decides sync/async via mode=auto by file size)
IGNITE_EXTRACTION_MAX_WAIT=300
IGNITE_EXTRACTION_CONNECT_TIMEOUT=30
IGNITE_EXTRACTION_WRITE_TIMEOUT=60
# Observability hint only (mirrors Ignite API MAX_SYNC_FILE_SIZE_DOC_MB); server remains source of truth
IGNITE_MAX_SYNC_DOC_MB=15

# Estimated remaining-balance alert (local spend vs a user-set budget — not live Google/OpenAI billing).
# Set this to your prepaid API credit or a monthly cap. 0 disables the remaining display and alerts.
IGNITE_BUDGET_USD=10
# Warn when remaining falls to this fraction of the budget (0.20 = 20% left).
IGNITE_BUDGET_WARN_REMAINING_PCT=0.20
# Critical when remaining falls to this fraction (0.05 = 5% left).
IGNITE_BUDGET_CRITICAL_REMAINING_PCT=0.05
# Toast duration when remaining-balance crosses warn/critical/exhausted.
IGNITE_BUDGET_TOAST_MS=7000

