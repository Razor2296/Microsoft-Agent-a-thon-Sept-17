# Example production overrides. Copy to app/.env.prod (never commit secrets).
IGNITE_ENV=production
IGNITE_RUNTIME_MODE=server
IGNITE_API_HOST=0.0.0.0
IGNITE_API_PORT=8000
IGNITE_DATA_DIR=/data
IGNITE_OTEL_ENABLED=true
IGNITE_CORS_ORIGINS=*
IGNITE_SESSION_TTL_SECONDS=7200
IGNITE_MAX_SESSIONS=50

# Ignite API S2S Extraction Integration
IGNITE_EXTRACTION_ENABLED=true
IGNITE_EXTRACTION_API_URL=https://ignite-api.azurecontainerapps.io
IGNITE_EXTRACTION_API_KEY=replace-me
IGNITE_EXTRACTION_POLL_INTERVAL=3
IGNITE_EXTRACTION_MAX_WAIT=120

