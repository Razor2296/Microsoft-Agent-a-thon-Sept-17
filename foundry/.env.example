# Microsoft Foundry project endpoint (Build → Overview → Project endpoint)
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_CONNECTION_STRING=

# Deployment that EXISTS in this Foundry project (Models + endpoints).
# Gemini first for Paso 3 — deploy gemini-2.5-flash (or your Gemini name) in Foundry.
MODEL_DEPLOYMENT_NAME=gemini-2.5-flash
FOUNDRY_REFRESH_AGENTS=false
# true = republish all agent versions; false = create-if-missing only (STD-005)

# Canonical agent names — must match Foundry Build → Agents (do NOT invent)
IGNITE_ORCHESTRATOR_AGENT=ignite-orchestrator-agent
IGNITE_DOCUMENT_AGENT=ignite-document-agent
IGNITE_IMAGE_AGENT=ignite-image-agent
IGNITE_AUDIO_AGENT=ignite-audio-agent
IGNITE_VIDEO_AGENT=ignite-video-agent
IGNITE_WORKFLOW_AGENT=ignite-document-workflow

# Ignite Chat SNAPSHOT (app/ in THIS repo) → Traces → workflow
# NEVER push Foundry changes to IgniteChat / IgniteAPI remotes.
FOUNDRY_ORCHESTRATION_ENABLED=true
FOUNDRY_BRAIN_LIVE=false
FOUNDRY_WORKFLOW_LIVE=false

AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
APPLICATIONINSIGHTS_CONNECTION_STRING=

FOUNDRY_USE_IGNITE_API=false
