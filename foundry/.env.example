# Microsoft Foundry project endpoint (Build → Overview → Project endpoint)
# Example: https://<resource>.services.ai.azure.com/api/projects/<project>
PROJECT_CONNECTION_STRING=

# Deployment that EXISTS in this Foundry project (Models + endpoints)
# juliancuray-7914 currently shows gpt-5-mini — use that unless you deploy another.
MODEL_DEPLOYMENT_NAME=gpt-5-mini

# Agent names (visible in Foundry → Build → Agents)
IGNITE_DOCUMENT_AGENT=ignite-document-agent
IGNITE_ORCHESTRATOR_AGENT=ignite-orchestrator-agent
IGNITE_WORKFLOW_AGENT=ignite-document-workflow

# Challenge 2 — tracing (set before running monitor.py)
AZURE_EXPERIMENTAL_ENABLE_GENAI_TRACING=true
APPLICATIONINSIGHTS_CONNECTION_STRING=
